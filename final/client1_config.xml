<enterpriseConfiguration>

    <!-- Databases -->
    <component name="Modules">
        <parameters>
            <Database name="hrMain" user="hrUser" password="hrPass2026" dsn="jdbc:oracle:thin:@hrdb.newco.net:1521/HR"/>
            <Database name="finMain" user="finUser" password="finPass2026" dsn="jdbc:oracle:thin:@findb.newco.net:1521/FIN"/>
        </parameters>
    </component>

    <!-- Messaging -->
    <component name="MessagingSystem">
        <parameters>
            <serverHost>mq01.newco.net</serverHost>
            <serverPort>61616</serverPort>
            <adminUser>msgAdmin</adminUser>
            <adminPassword>msgAdmin2026</adminPassword>
            <hrQueue>HRQueue</hrQueue>
            <financeQueue>FinanceQueue</financeQueue>
            <auditTopic>AuditTopic</auditTopic>
        </parameters>
    </component>

    <!-- Logging -->
    <component name="Logger">
        <parameters>
            <logLevel>INFO</logLevel>
            <logFormat>%d %p %c - %m%n</logFormat>
            <logFile>/var/log/hrfin/archive</logFile>
            <logArchive>/var/log/hrfin/archive</logArchive>
        </parameters>
    </component>

    <!-- Resources -->
    <component name="ResourceSet">
        <parameters>
            <baseDir>base</baseDir>
            <scriptsDir>/srv/hrfin/resources/scripts</scriptsDir>
            <reportsDir>/srv/hrfin/resources/reports</reportsDir>
        </parameters>
    </component>

    <!-- API -->
    <component name="ServiceGateway">
        <parameters>
            <endpointUrl>https://api.hrfin.newco.net/v5</endpointUrl>
            <authToken>Bearer hrfinToken2026</authToken>
            <timeout>15000</timeout>
        </parameters>
    </component>

    <!-- Storage -->
    <component name="StorageSystem">
        <parameters>
            <localPath>/mnt/hrfin/storage</localPath>
            <ftpHost>ftp.hrfin.newco.net</ftpHost>
            <ftpPort>2026</ftpPort>
            <ftpUser>ftpHrFin</ftpUser>
            <ftpPassword>ftpHrFin2026</ftpPassword>
        </parameters>
    </component>

</enterpriseConfiguration>
<?xml version="1.0" encoding="UTF-8"?>
<enterpriseConfig version="1">

    <!-- Authentication -->
    <Authentication>
        <Provider type="OAuth2"/>
        <Client>
            <Id>enterprise-client-001</Id>
            <Secret>SuperSecretKey123</Secret>
        </Client>
        <Token>
            <Endpoint>https://auth.example.com/token</Endpoint>
        </Token>
    </Authentication>

    <!-- Notification Service -->
    <Notifications>
        <SMTP>
            <Host>smtp.mail.example.com</Host>
            <Port>587</Port>
        </SMTP>
        <Sender>
            <Email>noreply@example.com</Email>
        </Sender>
        <Channels>
            <ErrorQueue>error-notifications</ErrorQueue>
            <InfoQueue>info-notifications</InfoQueue>
        </Channels>
    </Notifications>

    <!-- Monitoring -->
    <Monitoring>
        <Metrics>
            <Url>https://monitoring.example.com/metrics</Url>
        </Metrics>
        <Alert>
            <Threshold>85%</Threshold>
        </Alert>
        <Dashboard>
            <Url>https://monitoring.example.com/dashboard</Url>
        </Dashboard>
    </Monitoring>

    <!-- File Management -->
    <FileSystem>
        <UploadDir>/opt/app/uploads</UploadDir>
        <BackupDir>/opt/app/backups</BackupDir>
        <TempDir>/opt/app/tmp</TempDir>
    </FileSystem>

    <!-- External API -->
    <ExternalAPI>
        <Service>
            <Url>https://api.external-service.com</Url>
            <ApiKey>APIKEY-987654321</ApiKey>
            <Retry>3</Retry>
        </Service>
    </ExternalAPI>

    <!-- Cache -->
    <Cache>
        <Directory>/opt/app/cache</Directory>
        <MaxSize>512MB</MaxSize>
        <EvictionPolicy>LRU</EvictionPolicy>
    </Cache>

</enterpriseConfig>

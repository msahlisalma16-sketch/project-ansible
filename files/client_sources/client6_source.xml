<?xml version="1.0" encoding="UTF-8"?>
<enterpriseConfig version="1">

    <!-- Authentication -->
    <Authentication>
        <Provider type="OIDC"/>
        <Client>
            <Id>corp-client-999</Id>
            <Secret>SecureKey!2026</Secret>
        </Client>
        <Token>
            <Endpoint>https://auth.globalcorp.net/oauth/token</Endpoint>
        </Token>
    </Authentication>

    <!-- Notification Service -->
    <Notifications>
        <SMTP>
            <Host>smtp.globalcorp.net</Host>
            <Port>2525</Port>
            <TLS>true</TLS>
        </SMTP>
        <Sender>
            <Email>alerts@globalcorp.net</Email>
            <Name>GlobalCorp Alerts</Name>
        </Sender>
        <Channels>
            <ErrorQueue>system-errors</ErrorQueue>
            <InfoQueue>system-info</InfoQueue>
            <WarningQueue>system-warnings</WarningQueue>
        </Channels>
    </Notifications>

    <!-- Monitoring -->
    <Monitoring>
        <Metrics>
            <Url>https://metrics.globalcorp.net/v1</Url>
            <Interval>30s</Interval>
        </Metrics>
        <Alert>
            <Threshold>75%</Threshold>
            <Email>ops-team@globalcorp.net</Email>
        </Alert>
        <Dashboard>
            <Url>https://dashboard.globalcorp.net</Url>
            <Theme>dark</Theme>
        </Dashboard>
    </Monitoring>

    <!-- File Management -->
    <FileSystem>
        <UploadDir>/srv/global/uploads</UploadDir>
        <BackupDir>/srv/global/backups</BackupDir>
        <TempDir>/srv/global/tmp</TempDir>
        <LogsDir>/srv/global/logs</LogsDir>
    </FileSystem>

    <!-- External API -->
    <ExternalAPI>
        <Service>
            <Url>https://partnerapi.globalcorp.net/v3</Url>
            <ApiKey>PARTNER-KEY-2026-XYZ</ApiKey>
            <Retry>4</Retry>
            <Timeout>10000</Timeout>
        </Service>
    </ExternalAPI>

    <!-- Cache -->
    <Cache>
        <Directory>/srv/global/cache</Directory>
        <MaxSize>2GB</MaxSize>
        <EvictionPolicy>LFU</EvictionPolicy>
        <Compression>true</Compression>
    </Cache>

</enterpriseConfig>

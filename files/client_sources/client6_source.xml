<?xml version="1.0" encoding="UTF-8"?>
<enterpriseConfig version="1">

    <!-- Authentication -->
    <Authentication>
        <Provider type="SAML2"/>
        <Client>
            <Id>corp-client-2026</Id>
            <Secret>UltraSecureKey789</Secret>
        </Client>
        <Token>
            <Endpoint>https://login.corpcloud.net/sso/token</Endpoint>
        </Token>
    </Authentication>

    <!-- Notification Service -->
    <Notifications>
        <SMTP>
            <Host>smtp.corpcloud.net</Host>
            <Port>465</Port>
        </SMTP>
        <Sender>
            <Email>system@corpcloud.net</Email>
        </Sender>
        <Channels>
            <ErrorQueue>critical-alerts</ErrorQueue>
            <InfoQueue>general-updates</InfoQueue>
        </Channels>
    </Notifications>

    <!-- Monitoring -->
    <Monitoring>
        <Metrics>
            <Url>https://metrics.corpcloud.net/api</Url>
        </Metrics>
        <Alert>
            <Threshold>90%</Threshold>
        </Alert>
        <Dashboard>
            <Url>https://dashboard.corpcloud.net</Url>
        </Dashboard>
    </Monitoring>

    <!-- File Management -->
    <FileSystem>
        <UploadDir>/data/uploads</UploadDir>
        <BackupDir>/data/backups</BackupDir>
        <TempDir>/data/tmp</TempDir>
    </FileSystem>

    <!-- External API -->
    <ExternalAPI>
        <Service>
            <Url>https://partnerapi.corpcloud.net/v2</Url>
            <ApiKey>PARTNER-KEY-456XYZ</ApiKey>
            <Retry>5</Retry>
        </Service>
    </ExternalAPI>

    <!-- Cache -->
    <Cache>
        <Directory>/data/cache</Directory>
        <MaxSize>1GB</MaxSize>
        <EvictionPolicy>FIFO</EvictionPolicy>
    </Cache>

</enterpriseConfig>

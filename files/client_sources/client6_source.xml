<?xml version="1.0" encoding="UTF-8"?>
<enterpriseConfiguration>

    <!-- Authentication -->
    <component name="AuthSystem">
        <parameters>
            <provider>OAuth2</provider>
            <clientId>client9-app</clientId>
            <clientSecret>SecretKey9!@#</clientSecret>
            <tokenEndpoint>https://auth.client9.example.com/token</tokenEndpoint>
            <refreshInterval>3600</refreshInterval>
        </parameters>
    </component>

    <!-- Notification Service -->
    <component name="NotificationService">
        <parameters>
            <smtpHost>smtp.client9.example.com</smtpHost>
            <smtpPort>465</smtpPort>
            <senderEmail>alerts@client9.example.com</senderEmail>
            <errorChannel>error-channel9</errorChannel>
            <infoChannel>info-channel9</infoChannel>
            <warningChannel>warn-channel9</warningChannel>
        </parameters>
    </component>

    <!-- Monitoring -->
    <component name="MonitoringSystem">
        <parameters>
            <metricsEndpoint>https://monitor.client9.example.com/metrics</metricsEndpoint>
            <alertThreshold>80%</alertThreshold>
            <dashboardUrl>https://monitor.client9.example.com/dashboard</dashboardUrl>
            <logRetentionDays>30</logRetentionDays>
        </parameters>
    </component>

    <!-- File Management -->
    <component name="FileManager">
        <parameters>
            <uploadDir>/mnt/client9/uploads</uploadDir>
            <backupDir>/mnt/client9/backups</backupDir>
            <tempDir>/mnt/client9/tmp</tempDir>
            <archiveDir>/mnt/client9/archive</archiveDir>
        </parameters>
    </component>

    <!-- External API -->
    <component name="ExternalConnector">
        <parameters>
            <serviceUrl>https://api.client9.external.com</serviceUrl>
            <apiKey>APIKEY-CLIENT9-XYZ</apiKey>
            <retryCount>5</retryCount>
            <timeout>60</timeout>
        </parameters>
    </component>

    <!-- Cache -->
    <component name="CacheSystem">
        <parameters>
            <cacheDir>/mnt/client9/cache</cacheDir>
            <maxSize>1GB</maxSize>
            <evictionPolicy>FIFO</evictionPolicy>
            <compressionEnabled>true</compressionEnabled>
        </parameters>
    </component>

    <!-- Security -->
    <component name="SecuritySystem">
        <parameters>
            <firewallEnabled>true</firewallEnabled>
            <allowedIPs>192.168.1.0/24</allowedIPs>
            <encryptionAlgorithm>AES256</encryptionAlgorithm>
        </parameters>
    </component>

    <!-- Analytics -->
    <component name="AnalyticsService">
        <parameters>
            <trackingId>UA-CLIENT9-001</trackingId>
            <reportingEndpoint>https://analytics.client9.example.com/report</reportingEndpoint>
            <samplingRate>0.75</samplingRate>
        </parameters>
    </component>

</enterpriseConfiguration>

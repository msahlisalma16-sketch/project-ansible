<Configuration>

    <!-- Storage -->
    <component name="StorageSystem">
        <parameters>
            <localPath>/data/client9</localPath>
            <ftpHost>ftp.client9.local</ftpHost>
            <ftpUser>ftpuser9</ftpUser>
            <ftpPassword>ftppass9</ftpPassword>
        </parameters>
    </component>

    <!-- API -->
    <component name="ServiceGateway">
        <parameters>
            <endpointUrl>https://client9.local/api</endpointUrl>
            <authToken>token_client9</authToken>
            <timeout>120</timeout>
        </parameters>
    </component>

    <!-- Databases -->
    <component name="Modules">
        <parameters>
            <Database name="finMain" user="fin_user9" password="fin_pass9" dsn="FINDSN9"/>
        </parameters>
    </component>

    <!-- Messaging -->
    <component name="MessagingSystem">
        <parameters>
            <serverHost>msg.client9.local</serverHost>
            <serverPort>5674</serverPort>
        
        </parameters>
    </component>

    <!-- Logging -->
    <component name="Logger">
        <parameters>
            <logLevel>INFO</logLevel>
            <logFormat>%d [%t] %-5p %c - %m%n</logFormat>
            <logFile>/var/log/client9/app.log</logFile>
            <logArchive>/var/log/client9/archive</logArchive>
        </parameters>
    </component>

</Configuration>

<?xml version="1.0" encoding="UTF-8"?>
<enterpriseConfiguration>

    <!-- Databases -->
    <component name="Modules">
        <parameters>
            <Database name="hrMain" user="#{modules.hr.username}" password="#{modules.hr.password}" dsn="#{modules.hr.dsn}"/>
            <Database name="finMain" user="#{modules.finance.username}" password="#{modules.finance.password}" dsn="#{modules.finance.dsn}"/>
        </parameters>
    </component>

    <!-- Messaging -->
    <component name="MessagingSystem">
        <parameters>
            <serverHost>#{messaging.server.host}</serverHost>
            <serverPort>#{messaging.server.port}</serverPort>
            <adminUser>#{messaging.admin.user}</adminUser>
            <adminPassword>#{messaging.admin.password}</adminPassword>
            <hrQueue>#{messaging.queue.hr}</hrQueue>
            <financeQueue>#{messaging.queue.finance}</financeQueue>
            <auditTopic>#{messaging.topic.audit}</auditTopic>
        </parameters>
    </component>

    <!-- Logging -->
    <component name="Logger">
        <parameters>
            <logLevel>#{logging.level}</logLevel>
            <logFormat>#{logging.format}</logFormat>
            <logFile>#{logging.file.path}</logFile>
            <logArchive>#{logging.archive.path}</logArchive>
        </parameters>
    </component>

    <!-- Resources -->
    <component name="ResourceSet">
        <parameters>
            <baseDir>#{resources.dir.base}</baseDir>
            <scriptsDir>#{resources.dir.scripts}</scriptsDir>
            <reportsDir>#{resources.dir.reports}</reportsDir>
        </parameters>
    </component>

    <!-- API -->
    <component name="ServiceGateway">
        <parameters>
            <endpointUrl>#{api.gateway.url}</endpointUrl>
            <authToken>#{api.gateway.token}</authToken>
            <timeout>#{api.gateway.timeout}</timeout>
        </parameters>
    </component>

    <!-- Storage -->
    <component name="StorageSystem">
        <parameters>
            <localPath>#{storage.local}</localPath>
            <ftpHost>#{storage.ftp.host}</ftpHost>
            <ftpPort>#{storage.ftp.port}</ftpPort>
            <ftpUser>#{storage.ftp.user}</ftpUser>
            <ftpPassword>#{storage.ftp.password}</ftpPassword>
        </parameters>
    </component>

</enterpriseConfiguration>
<catalog>
    <service id="1">
        <name>Messaging Service</name>
        <endpoint>#{messaging.server.host}:#{messaging.server.port}</endpoint>
        <protocol>tcp</protocol>
    </service>
    <service id="2">
        <name>Backup Messaging Service</name>
        <endpoint>#{messaging.server.backup.host}:#{messaging.server.backup.port}</endpoint>
        <protocol>tcp</protocol>
    </service>
    <service id="3">
        <name>Database Service</name>
        <endpoint>#{database.connection.url}</endpoint>
        <credentials>
            <user>#{database.connection.user}</user>
            <password>#{database.connection.password}</password>
        </credentials>
    </service>
    <service id="4">
        <name>Analytics Database</name>
        <endpoint>#{database.analytics.url}</endpoint>
        <credentials>
            <user>#{database.analytics.user}</user>
            <password>#{database.analytics.password}</password>
        </credentials>
    </service>
    <service id="5">
        <name>Authentication Module</name>
        <token>#{modules.auth.token}</token>
    </service>
    <service id="6">
        <name>Reporting Module</name>
        <endpoint>#{modules.reporting.endpoint}</endpoint>
        <format>json</format>
    </service>
    <service id="7">
        <name>Analytics Module</name>
        <endpoint>#{modules.analytics.endpoint}</endpoint>
        <refresh>daily</refresh>
    </service>
    <service id="8">
        <name>Monitoring Module</name>
        <endpoint>#{modules.monitoring.endpoint}</endpoint>
        <interval>5m</interval>
    </service>
</catalog>
